{
  "$name": "D7 Harbor Ink",
  "$basis": "NEAR AI OS design system (tools/repos/nearai_near-ai-os-design-system, docs/guidelines/02-color.md): dark neutrals, NEAR AI blue accent stepped for contrast, status mark/text/tint triplets. Additions: NEAR mint for 'Verified' marks, one warm brass for money and receipt marks.",
  "color": {
    "scene":        {"value": "#070a1a", "note": "page ground (NEAR AI dark scene)"},
    "scene-warm":   {"value": "#11152b", "note": "centre of the hero gradient"},
    "pane":         {"value": "#0d1124", "note": "opaque pane (NEAR AI pane-opaque dark)"},
    "glass":        {"value": "rgba(13,17,36,0.72)", "note": "glass panel fill over the 3D scene; blur 14px"},
    "card":         {"value": "#171c33", "note": "card on an opaque pane (card-on-opaque)"},
    "card-quiet":   {"value": "#13182d"},
    "line":         {"value": "rgba(242,243,248,0.08)", "note": "hairline"},
    "line-strong":  {"value": "rgba(242,243,248,0.16)"},
    "text":         {"value": "#f2f3f8", "note": "16.9:1 on pane"},
    "text-2":       {"value": "#b9bfd0", "note": "10.1:1 on pane"},
    "text-3":       {"value": "#8b91a7", "note": "5.9:1 on pane; captions only"},
    "accent":       {"value": "#7ebcff", "note": "the one primary action / selection; dark text on it"},
    "accent-press": {"value": "#6aa8eb"},
    "on-accent":    {"value": "#071a2e", "note": "8.8:1 on accent"},
    "accent-text":  {"value": "#c6e1ff"},
    "brand-blue":   {"value": "#0091fd", "note": "NEAR AI blue: marks, hero light, never body text"},
    "accent-tint":  {"value": "rgba(0,145,253,0.18)"},
    "brass":        {"value": "#d6b46a", "note": "money/receipt marks only; echoes the 3dicons premium gold"},
    "brass-tint":   {"value": "rgba(214,180,106,0.14)"},
    "focus":        {"value": "#7ebcff"}
  },
  "proof": {
    "verified":     {"mark": "#00ec97", "text": "#b6f5d9", "tint": "rgba(0,236,151,0.14)", "glyph": "check-seal", "means": "signature or attestation checked on-chain"},
    "pending":      {"mark": "#ffc75c", "text": "#ffd585", "tint": "rgba(255,199,92,0.16)", "glyph": "clock", "means": "submitted, waiting for confirmation"},
    "gateway-only": {"mark": "#7ebcff", "text": "#c6e1ff", "tint": "rgba(126,188,255,0.16)", "glyph": "half-seal", "means": "only the gateway's word, no on-chain check"},
    "check-failed": {"mark": "#ff6b6b", "text": "#ffd3d3", "tint": "rgba(255,107,107,0.16)", "glyph": "cross-seal", "means": "a check ran and failed"},
    "external":     {"mark": "#9085e9", "text": "#d9d4ff", "tint": "rgba(144,133,233,0.16)", "glyph": "arrow-out", "means": "left for an outside service"},
    "no-proof":     {"mark": "#a9a9b0", "text": "#d4d5dc", "tint": "rgba(255,255,255,0.08)", "glyph": "dashed-ring", "means": "nothing to check"},
    "not-recorded": {"mark": "#6b7086", "text": "#a9adbd", "tint": "rgba(255,255,255,0.05)", "glyph": "hollow-dot", "means": "not written to the chronicle"}
  },
  "action": {
    "allowed": {"ref": "proof.verified"},
    "refused": {"ref": "proof.check-failed"},
    "escalate": {"ref": "proof.pending"},
    "freeze":  {"mark": "#a8d8ff", "text": "#dff0ff", "tint": "rgba(168,216,255,0.14)"}
  },
  "radius": {"sm": "8px", "md": "12px", "lg": "18px", "pill": "999px"},
  "space":  {"1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px"},
  "font": {
    "ui": "Inter, ui-sans-serif, system-ui, sans-serif",
    "display": "'Inter Tight', Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },
  "motion": {
    "spring": "cubic-bezier(0.34,1.56,0.64,1)",
    "out": "cubic-bezier(0.16,1,0.3,1)",
    "fast": "140ms", "base": "240ms", "slow": "480ms",
    "rule": "transform/opacity only; everything stops under prefers-reduced-motion"
  },
  "shadow": {"panel": "0 1px 0 rgba(255,255,255,0.04) inset, 0 20px 50px rgba(0,0,0,0.45)"}
}
