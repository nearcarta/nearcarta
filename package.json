{
  "name": "nearcarta",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "app"
  ],
  "scripts": {
    "test": "npm -w backend test",
    "test:integration": "npm -w backend run test:integration",
    "build": "npm -w app run build",
    "e2e": "playwright test -c e2e/playwright.config.js",
    "verify": "node backend/scripts/verify-proofs.js",
    "verify:mainnet": "node backend/scripts/verify-mainnet.js",
    "start": "node backend/src/server.js",
    "test:contracts": "bash scripts/test-contracts.sh",
    "tee": "node backend/scripts/record-tee.js",
    "wasm-hash": "node -e \"const c=require('crypto'),b=require('bs58').default;console.log(b.encode(c.createHash('sha256').update(require('fs').readFileSync(process.argv[1]||'contracts/artifacts/oath.wasm')).digest()))\"",
    "txs": "node backend/scripts/txs-table.js",
    "readme-numbers": "node backend/scripts/readme-numbers.js",
    "check-cited": "node scripts/check-cited.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
