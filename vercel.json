{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "app/dist",
  "installCommand": "npm ci --omit=dev",
  "functions": {
    "api/index.js": {
      "includeFiles": "shared/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/design/D6_dashboards/src/data.js",
      "destination": "/live/data.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
