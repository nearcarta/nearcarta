{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "app/dist",
  "installCommand": "npm ci --omit=dev",
  "rewrites": [
    {
      "source": "/loop",
      "destination": "/loop.html"
    },
    {
      "source": "/ledger",
      "destination": "/ledger.html"
    },
    {
      "source": "/judge",
      "destination": "/judges.html"
    },
    {
      "source": "/console",
      "destination": "/console.html"
    },
    {
      "source": "/ferry-widget",
      "destination": "/ferry-widget.html"
    },
    {
      "source": "/pay/:id",
      "destination": "/pay/index.html"
    },
    {
      "source": "/deed/:token",
      "destination": "/deed/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://nearcarta-api.onrender.com/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/console",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/shops/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}